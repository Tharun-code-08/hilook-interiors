{
  "name": "hilook-interiors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frames:manifest": "node scripts/generate-frame-manifest.mjs",
    "predev": "node scripts/clean-stale-build.mjs && npm run frames:manifest && npm run db:migrate",
    "dev": "next dev",
    "prebuild": "npm run frames:manifest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import": "node scripts/import-json-store.mjs",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lhci": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "next": "^15.5.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
