# Copy to .env.local and fill in. .env.local is git-ignored.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Signs the admin session JWT.
#
# In production this is REQUIRED — the app throws on the first authenticated
# request without it rather than falling back to a file on disk, because that
# file lives on a filesystem serverless hosts reset between invocations, which
# silently invalidates every session.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Absolute public origin, no trailing slash. Used for metadataBase, canonical
# URLs, sitemap entries, and Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Leave BOTH blank for local development: the app opens data/hilook.db as a
# plain SQLite file, no account or network needed.
#
# Set them for any serverless deploy. The same libSQL driver then talks to
# Turso over HTTP and writes nothing to the filesystem.
#   turso db create hilook
#   turso db show hilook --url
#   turso db tokens create hilook
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------

# Unset  → uploads are written to .storage/ (outside public/) and served
#          through /api/media/<key>. Fine for local dev and a VPS with a disk.
# Set    → uploads go to Vercel Blob instead, and no local write happens.
#          Requires: npm install @vercel/blob
BLOB_READ_WRITE_TOKEN=

# Optional. When the bucket has a known public CDN base, media URLs point
# straight at it instead of routing through /api/media.
BLOB_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Email (password reset links)
# ---------------------------------------------------------------------------

# Leave these unset and "Forgot password?" is simply not offered. Set them to
# send reset links from your own mailbox over SMTP. Use the settings your mail
# host gives for that address; port 465 is TLS from the start, 587 is
# STARTTLS. For example:
#   Google Workspace  smtp.gmail.com  465  the address  an App Password
#   Zoho Mail (India) smtp.zoho.in    465  the address  its password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Hilook Interiors <support@claxonai.in>"

# Recovery email for the owner account. Used when the account is first
# created, and on a later deploy for an owner that has no email yet. It never
# replaces an address already set from the panel.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# Salt for the daily-rotating visitor hash used to count unique visitors.
# No IP or user agent is ever stored — only sha256(day + salt + ip + ua),
# and the day component means yesterday's hashes can't be linked to today's.
# Falls back to SESSION_SECRET when unset.
ANALYTICS_SALT=

# ---------------------------------------------------------------------------
# Trusted proxy configuration
# ---------------------------------------------------------------------------

# Number of proxies in front of the app. The rate limiter reads the client IP
# from x-forwarded-for, which the client can forge when nothing strips it —
# this says how many right-hand entries to trust.
#   0 = direct/no proxy (falls back to the socket address)
#   1 = one reverse proxy or CDN (Vercel, Cloudflare, nginx)
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# First run only
# ---------------------------------------------------------------------------

# Password for the owner account created on a fresh database. If unset, a
# random one is generated and printed to the server log exactly once. Either
# way the account must change it at first sign-in.
ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# Rate limits (optional)
# ---------------------------------------------------------------------------
# Per-bucket request ceilings, overriding the defaults in lib/rate-limit.ts.
# Only the count is adjustable; the window is fixed, so these can loosen a
# limit but never remove one.
#
# Worth setting if your visitors share an address — several people in one
# office behind a single NAT IP share a bucket, and the default of five
# contact submissions an hour is a sensible ceiling for a home visitor and a
# wrong one for them.
#
# RATE_LIMIT_CONTACT=5
# RATE_LIMIT_NEWSLETTER=3
# RATE_LIMIT_LOGIN=5
