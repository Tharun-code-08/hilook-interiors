{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-devcheck/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-err/types/**/*.ts",
    ".next-lhci/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-probe-dev/types/**/*.ts",
    ".next-probe-prod/types/**/*.ts",
    ".next-sec/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-walk/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-flag/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
